# Solar Monitor environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

MQTT_HOST=192.168.x.x
MQTT_PORT=1883
MQTT_USER=solar
MQTT_PASS=your_mqtt_password_here
BLE_MAC_1=AA:BB:CC:DD:EE:FF
BLE_MAC_2=11:22:33:44:55:66

# Optional Wanderer Li 30A read-only monitoring through the Renogy BT-1.
# Leave empty to keep controller entities unavailable without polling.
WANDERER_MAC=
WANDERER_ADDRESS=0xFF
